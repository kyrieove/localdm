<UserControl x:Class="LocalDm.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="44,38,44,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 扉页 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="本局" Style="{StaticResource Display}" />
            <TextBlock Text="选择一本已装订的剧本，翻开就是这一局。"
                       Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource InkSoft}" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PaperDim}"
                BorderBrush="{StaticResource Rule}" BorderThickness="1" Margin="0,24,0,0">
            <Grid>
                <!-- 空状态：像一张还没写字的扉页 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                            Visibility="{Binding HasPackages, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="还没有装订好的剧本" Style="{StaticResource DisplaySmall}"
                               HorizontalAlignment="Center" Foreground="{StaticResource InkSoft}" />
                    <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               MaxWidth="420" TextAlignment="Center"
                               FontSize="14" Foreground="{StaticResource Muted}" LineHeight="23" />
                </StackPanel>

                <ListBox x:Name="PackageList" ItemsSource="{Binding Packages}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Margin="18" VerticalAlignment="Top">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 书脊条 -->
                                <Border Grid.Column="0" Background="{StaticResource Cloth}" />

                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource DisplaySmall}"
                                               FontSize="21" />
                                    <TextBlock Text="{Binding Summary}" Margin="0,6,0,0"
                                               Style="{StaticResource Figure}" FontSize="13" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="已装订" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource InkSoft}"
                                           Margin="18,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Grid.Column="0" Content="翻开这本，开始这一局"
                    Command="{Binding OpenCommand}" Style="{StaticResource SealButton}"
                    Padding="26,14" Margin="0" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                       Margin="18,0,0,0" FontSize="13" Foreground="{StaticResource InkSoft}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
