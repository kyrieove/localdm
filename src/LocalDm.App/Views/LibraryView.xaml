<UserControl x:Class="LocalDm.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,34,34,30" MaxWidth="880" HorizontalAlignment="Stretch">
            <!-- 扉页 -->
            <TextBlock Text="剧本库" Style="{StaticResource Display}" FontSize="26" />
            <TextBlock Text="选一本准备完成的剧本，或接着上次的进度继续。"
                       Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource InkSoft}" />
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ImportButton" Grid.Column="0" Content="导入新剧本"
                        Command="{Binding ImportCommand}" Style="{StaticResource SealButton}"
                        Padding="22,10" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                           Style="{StaticResource ChatMeta}" TextWrapping="Wrap"
                           Text="导入全程不显示剧本正文与卡面，只显示文件夹、页数与流程。" />
            </Grid>

            <!-- 平板加入：软件一开就有，不管有没有打开剧本 -->
            <Border x:Name="TabletJoinCard" DataContext="{Binding Tablet}" Margin="0,18,0,0" Padding="20" CornerRadius="16"
                    Background="{StaticResource PaperDim}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="140" Height="140" Background="White"
                            CornerRadius="12" VerticalAlignment="Top">
                        <Image x:Name="TabletJoinQr" Source="{Binding QrCode}" Width="128" Height="128"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="平板加入" Style="{StaticResource RailLabel}" />
                        <TextBlock x:Name="TabletJoinHeadline" Text="{Binding Headline}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource ChatMeta}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TabletJoinAddress" ItemsSource="{Binding Addresses}"
                                      SelectedItem="{Binding SelectedAddress}" Height="32" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="复制网址" Command="{Binding CopyCommand}"
                                    Style="{StaticResource QuietButton}" Padding="14,6" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding JoinedSummary}" Style="{StaticResource ChatMeta}" Margin="0,8,0,0"
                                   Visibility="{Binding JoinedSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                        <!-- 平板关了浏览器或换 App 扫码会认不回角色：在这里释放后重新认领 -->
                        <ItemsControl x:Name="TabletJoinedRoles" ItemsSource="{Binding JoinedRoles}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName, StringFormat=释放「{0}」}" Command="{Binding ReleaseCommand}"
                                            Style="{StaticResource QuietButton}" FontSize="12" Padding="10,4" Margin="0,4,6,0"
                                            ToolTip="平板认不回这个角色时点这里，再在平板上重新选它；翻开的页要重新翻" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource ErrorWash}"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Name="TabletJoinError" Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource SealDeep}" />
                        </Border>
                        <Expander Header="连不上怎么办" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Seal}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20" Margin="0,6,0,0"
                                       Foreground="{StaticResource InkSoft}"
                                       Text="1. 平板和电脑连同一个 Wi-Fi。&#10;2. Windows 第一次弹出网络提示时，选「专用网络」并允许。&#10;3. 网络类型若是「公用」，在 Windows 网络设置里改成「专用」。&#10;4. 仍不行：先在电脑浏览器里打开上面的网址，能打开就是平板那边的网络问题。" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 正在导入：点一下回到向导 -->
            <Border Margin="0,16,0,0" Padding="18,14" CornerRadius="16"
                    Background="{StaticResource PaperDim}" BorderBrush="{StaticResource Seal}"
                    BorderThickness="1"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ImportingLabel" Grid.Column="0" Text="{Binding ImportingText}"
                               Style="{StaticResource ChatMeta}" VerticalAlignment="Center" />
                    <Button x:Name="BackToImportButton" Grid.Column="1" Content="回到导入"
                            Command="{Binding ImportCommand}" Style="{StaticResource QuietButton}"
                            Padding="16,8" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,22,0,0" />

            <!-- 上一局还没走完：重启后直接接着玩 -->
            <Border Margin="0,22,0,0" Padding="18,15"
                    Background="{StaticResource PaperDim}" BorderBrush="{StaticResource Seal}"
                    BorderThickness="2" CornerRadius="16"
                    Visibility="{Binding HasResumableSession, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="上一局还没走完" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Seal}" />
                        <TextBlock Text="{Binding ResumableTitle}" Style="{StaticResource RailTitle}"
                                   FontSize="17" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ResumableDetail}" Style="{StaticResource ChatMeta}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="继续这一局" Command="{Binding ContinueCommand}"
                            Style="{StaticResource SealButton}" VerticalAlignment="Center"
                            Padding="20,10" Margin="22,0,0,0" />
                </Grid>
            </Border>

            <!-- 存档在、包不在：明说不能恢复，不用新包顶上去跳过环节 -->
            <Border Margin="0,22,0,0" Padding="18,14" CornerRadius="12"
                    Background="{StaticResource SealWash}"
                    Visibility="{Binding HasOrphanNotice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="有一局存档暂时打不开" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SealDeep}" />
                    <TextBlock Text="{Binding OrphanNotice}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource OnSealWash}" LineHeight="20" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 已装订的剧本 -->
            <TextBlock Text="已装订" Style="{StaticResource RailLabel}" Margin="0,26,0,6" />
            <ListBox x:Name="PackageList" ItemsSource="{Binding Packages}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Seal}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource RailTitle}" FontSize="17" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource ChatMeta}"
                                           Margin="0,5,0,0" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Readiness}" Style="{StaticResource ChatMeta}"
                                           VerticalAlignment="Center" Margin="16,0,8,0" />
                                <Button Content="重新整理流程" Style="{StaticResource TopBarButton}"
                                        Padding="8,3" Click="OnRefineFlow"
                                        ToolTip="改流程不用重新识别，确认后生成新版本的包" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 没有剧本时给一条能走的路 -->
            <Border Margin="0,6,0,0" Padding="20,18" CornerRadius="16"
                    Background="{StaticResource PaperDim}"
                    Visibility="{Binding HasPackages, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource Muted}" LineHeight="22" />
            </Border>

            <!-- 演示剧本：留在剧本库，不摆在游玩界面里 -->
            <TextBlock Text="熟悉操作" Style="{StaticResource RailLabel}" Margin="0,26,0,6" />
            <Border Padding="20,18" CornerRadius="16"
                    Background="{StaticResource PaperDim}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="演示剧本" Style="{StaticResource RailTitle}" FontSize="17" />
                        <TextBlock Text="不含真实剧情，用来熟悉按钮与声音。"
                                   Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button x:Name="DemoButton" Grid.Column="1" Content="体验演示"
                            Command="{Binding LoadDemoCommand}" Style="{StaticResource QuietButton}"
                            VerticalAlignment="Center" Padding="18,9" Margin="22,0,0,0" />
                </Grid>
            </Border>

            <!-- 开局 -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Grid.Column="0" Content="翻开这本，开始这一局"
                        Command="{Binding OpenCommand}" Style="{StaticResource SealButton}"
                        Padding="24,12" Margin="0"
                        Visibility="{Binding HasPackages, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"
                           Margin="16,0,0,0" Style="{StaticResource ChatMeta}" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
