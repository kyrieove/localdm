<UserControl x:Class="LocalDm.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LocalDm.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏：本局对话 / 公开材料 ===== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="34,0">
            <Grid Height="64">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShellTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <!-- 主持人在朗读时出现；空闲不显示，不占注意力 -->
                    <Border x:Name="SpeakingPill" CornerRadius="14" Padding="10,4,12,4" Margin="14,0,0,0"
                            VerticalAlignment="Center" Background="{StaticResource SealWash}"
                            Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:ActivityDots IsAnimating="{Binding IsSpeaking}" DotBrush="{StaticResource OnSealWash}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="主持人正在说" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSealWash}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BackToChatButton" Content="回到对话"
                            Command="{Binding ShowConversationCommand}"
                            Style="{StaticResource TopBarButton}" Margin="0,0,8,0"
                            Visibility="{Binding ShowMaterials, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="MaterialsButton" Content="已公开材料"
                            Command="{Binding ShowMaterialsCommand}"
                            Style="{StaticResource TopBarButton}"
                            Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 横幅区：暂停提示与同步异常 -->
        <StackPanel Grid.Row="1">
            <!-- 暂停横幅：进度已保存，说话仍然可以 -->
            <Border Margin="34,14,34,0" Padding="16,12" CornerRadius="12"
                    Background="{StaticResource SealWash}"
                    Visibility="{Binding Session.IsPausedNow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="本局已暂停，进度已保存。你仍然可以提问；准备继续时，点左侧「继续本局」。"
                           Style="{StaticResource ChatMeta}" FontSize="12" Foreground="{StaticResource OnSealWash}" />
            </Border>

            <!-- 同步异常：公开消息没存进去。横幅带重试，不能一闪而过，也不能说「已同步」。 -->
            <Border x:Name="PublicSyncErrorBanner" Margin="34,14,34,0" Padding="16,12" CornerRadius="12"
                    Background="{StaticResource ErrorWash}"
                    Visibility="{Binding HasPublicSyncError, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PublicSyncErrorText}" TextWrapping="Wrap"
                               Style="{StaticResource ChatMeta}" FontSize="12" Foreground="{StaticResource Ink}" />
                    <Button Grid.Column="1" Content="重试同步" Command="{Binding RetryPublicSyncCommand}"
                            Style="{StaticResource TopBarButton}" Padding="{StaticResource PadButtonSmall}" Margin="10,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== 主区 1：对话 ===== -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,26,0,10"
                      Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="{Binding ChatMaxWidth}" HorizontalAlignment="Stretch" Margin="34,0">
                <TextBlock Text="本局对话，从这里继续" Style="{StaticResource ChatMeta}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,26" />

                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,26">
                                <!-- 主持回复 -->
                                <Grid Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                            HorizontalAlignment="Left" Background="{StaticResource Seal}">
                                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="17"
                                                   Foreground="{StaticResource OnSeal}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding AuthorName}" Style="{StaticResource ChatMeta}" FontSize="12" />
                                        <TextBlock Text=" · " Style="{StaticResource ChatMeta}" FontSize="12" />
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource ChatMeta}" FontSize="12" />
                                    </StackPanel>
                                    <Border Background="{StaticResource Bubble}" CornerRadius="4,18,18,18"
                                            Padding="18,12" HorizontalAlignment="Left">
                                        <TextBlock x:Name="HostProse" Text="{Binding Text}" Style="{StaticResource ChatBody}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
                                        <TextBlock Text="{Binding SpeechNote}" Style="{StaticResource ChatMeta}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="重播" Command="{Binding ReplayCommand}"
                                                Style="{StaticResource TopBarButton}" Padding="{StaticResource PadButtonSmall}" Margin="10,0,0,0"
                                                Visibility="{Binding CanReplay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 玩家消息 -->
                                <StackPanel HorizontalAlignment="Right"
                                            Visibility="{Binding IsPlayer, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="{StaticResource AvatarWash}" CornerRadius="18,4,18,18"
                                            Padding="18,12" MaxWidth="{Binding BubbleMaxWidth}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap"
                                                   LineHeight="26" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource Ink}" />
                                    </Border>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource ChatMeta}" FontSize="10"
                                               HorizontalAlignment="Right" Margin="0,4,2,0" />
                                </StackPanel>

                                <!-- 阶段事件：一条细线，不抢对话 -->
                                <Grid Margin="0,2,0,4"
                                      Visibility="{Binding IsEvent, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Seal}" TextAlignment="Center" TextWrapping="Wrap"
                                               Margin="14,0" />
                                    <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    进行中 / 失败：就排在对话末尾，正是回复将要出现的位置。
                    只在真的在做或失败时出现，空闲不占屏，也没有一块常驻的「就绪」。
                -->
                <Border x:Name="ActivityRow" Padding="16,14" CornerRadius="16" Margin="52,0,0,8"
                        Background="{StaticResource PaperDim}"
                        Visibility="{Binding Activity.IsDisplayed, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ActivityDots Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                IsAnimating="{Binding Activity.IsActive}"
                                                Visibility="{Binding Activity.IsActive, Converter={StaticResource BoolToVisibility}}">
                            <controls:ActivityDots.Style>
                                <Style TargetType="{x:Type controls:ActivityDots}">
                                    <Setter Property="DotBrush" Value="{StaticResource Seal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Activity.Kind}" Value="Speaking">
                                            <Setter Property="DotBrush" Value="{StaticResource Ink}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Activity.Kind}" Value="Error">
                                            <Setter Property="DotBrush" Value="{StaticResource SealDeep}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:ActivityDots.Style>
                        </controls:ActivityDots>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Activity.Title}" FontSize="13" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activity.IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Activity.IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SealDeep}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Activity.Steps}" Margin="0,4,0,0"
                                          Visibility="{Binding Activity.IsActive, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Prefix}" Style="{StaticResource ChatMeta}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Seal}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Activity.Detail}" Style="{StaticResource ChatMeta}" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Activity.Elapsed}" Style="{StaticResource ChatMeta}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 主区 2：已公开材料与复盘 ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Padding="34,30,34,20"
                      Visibility="{Binding ShowMaterials, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="这里只呈现已经公开的材料编号。未发放的材料不会出现在这里。"
                           Style="{StaticResource ChatMeta}" FontSize="13" />

                <ItemsControl ItemsSource="{Binding Session.ReleasedMaterials}" Margin="0,26,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid>
                                    <TextBlock Text="{Binding}" FontSize="14" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="已发放" Style="{StaticResource ChatMeta}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="还没有公开的材料。发放后，编号会显示在这里，也会留在对话记录中。"
                           FontSize="13" Margin="0,26,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Session.ReleasedMaterials.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 已公开的真相：宽幅按块渲染 -->
                <StackPanel Visibility="{Binding Session.HasRevealedText, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,34,0,0">
                    <Border Height="1" Background="{StaticResource Rule}" Margin="0,0,0,24" />
                    <TextBlock Text="结局与复盘" Style="{StaticResource DisplaySmall}" FontSize="20" />
                    <TextBlock Text="等宽排版 · 可横向与纵向滚动查看完整时间线"
                               Style="{StaticResource ChatMeta}" Margin="0,6,0,20" />

                    <ItemsControl ItemsSource="{Binding Session.TruthBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <TextBlock Text="{Binding Text}" FontSize="19" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Seal}" Margin="0,10,0,10" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Paragraph">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                           FontSize="15" LineHeight="26"
                                                                           LineStackingStrategy="BlockLineHeight"
                                                                           Foreground="{StaticResource Ink}" Margin="0,0,0,14" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Code">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <Border Background="{StaticResource PaperDim}"
                                                                        CornerRadius="16" Padding="18,14" Margin="0,0,0,16">
                                                                    <controls:MonospaceGrid Lines="{Binding Lines}"
                                                                                           CellSize="15"
                                                                                           TextBrush="{StaticResource Ink}"
                                                                                           GuideBrush="{StaticResource Rule}" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Table">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <Border Background="{StaticResource PaperDim}"
                                                                        CornerRadius="16" Padding="18,14" Margin="0,0,0,16">
                                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <ItemsControl ItemsSource="{Binding}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding}" FontSize="14"
                                                                                                       Margin="0,0,18,0" TextWrapping="Wrap" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 底边固定输入区 ===== -->
        <Border Grid.Row="3" Padding="0,10,0,18" Background="{DynamicResource Paper}"
                Visibility="{Binding ShowConversation, Converter={StaticResource BoolToVisibility}}">
            <Grid MaxWidth="{Binding ChatMaxWidth}" HorizontalAlignment="Stretch" Margin="34,0,34,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" CornerRadius="12"
                        Background="{StaticResource SealWash}"
                        Visibility="{Binding HasPendingCorrection, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PendingCorrectionText}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="ConfirmCorrectionButton" Content="确认"
                                Command="{Binding ConfirmCorrectionCommand}" Style="{StaticResource SealButton}"
                                Padding="{StaticResource PadButton}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="不用" Command="{Binding DismissCorrectionCommand}"
                                Style="{StaticResource QuietButton}" Padding="{StaticResource PadButton}" Margin="6,0,0,0" />
                    </Grid>
                </Border>

                <!-- 快捷意图：只在对话里用得上，待开局和忙碌时不摆 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="AskStatusButton" Content="现在该做什么？"
                            Command="{Binding AskStatusCommand}" Style="{StaticResource TopBarButton}"
                            BorderBrush="{StaticResource Rule}" BorderThickness="1" Margin="0,0,8,0" />
                    <Button x:Name="AskRulesButton" Content="再讲一次规则"
                            Command="{Binding AskRulesCommand}" Style="{StaticResource TopBarButton}"
                            BorderBrush="{StaticResource Rule}" BorderThickness="1" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource ComposerFrame}">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="InputBox"
                                     AutomationProperties.AutomationId="ComposerInput"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     PreviewKeyDown="OnInputPreviewKeyDown" />
                            <!--
                                输入框为空时的提示：WPF 的 TextBox 没有占位文本。
                                用输入法打拼音时，拼音还在候选窗口里、没进 Text，只看 InputText 会和拼音叠在一起；
                                所以有键盘焦点时一律让位，只有失去焦点且确实为空时才显示。
                            -->
                            <TextBlock x:Name="ComposerPlaceholder"
                                       Text="对主持人说点什么，或先用左侧的动作推进这一步。"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding InputText}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ComposerHint}" Style="{StaticResource ChatMeta}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DictationHint}" Style="{StaticResource ChatMeta}"
                                           Margin="12,0,0,0" Foreground="{StaticResource Seal}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="DictationHint"
                                           Visibility="{Binding HasDictationHint, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Button x:Name="DictationButton" Grid.Column="1"
                                    Margin="0,0,8,0" Command="{Binding ToggleDictationCommand}"
                                    AutomationProperties.AutomationId="DictationButton"
                                    ToolTip="语音输入（右 Alt）"
                                    Visibility="{Binding DictationAvailable, Converter={StaticResource BoolToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SendButton}">
                                        <Setter Property="Background" Value="{StaticResource PaperDim}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Silver}" />
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Seal}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Seal}" />
                                                <Setter Property="Foreground" Value="{StaticResource OnSeal}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <!-- 图标放进带 Icon 样式的 TextBlock：按钮上的 FontFamily 会被隐式 TextBlock 样式盖成雅黑，显示成方框 -->
                                <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="15" />
                            </Button>

                            <!-- 停止随忙碌出现；空输入时发送不可点 -->
                            <Button x:Name="StopButton" Grid.Column="2" Content="■"
                                    Command="{Binding StopCommand}" Style="{StaticResource SendButton}"
                                    Background="{StaticResource Ink}" BorderBrush="{StaticResource Ink}"
                                    ToolTip="停止生成或朗读"
                                    Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                            <Button x:Name="SendButton" Grid.Column="2" Content="↑"
                                    Command="{Binding SendCommand}" Style="{StaticResource SendButton}"
                                    IsEnabled="{Binding CanSend}" ToolTip="发送（Enter）"
                                    Visibility="{Binding ShowStop, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Enter 发送 · Shift+Enter 换行 · 中文组合输入不会误发"
                                   Style="{StaticResource ChatMeta}" FontSize="10" />
                        <TextBlock x:Name="ContextUsageText" Text="{Binding ContextUsageText}"
                                   FontSize="10" Margin="16,0,0,0" VerticalAlignment="Center"
                                   ToolTip="上下文占用：接近上限时会自动把较早的对话整理成备忘">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ContextUsageHigh}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Seal}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 整理过几次：备忘正文不上屏，只报次数 -->
                        <TextBlock x:Name="CompactionCountText" Text="{Binding CompactionCountText}"
                                   Style="{StaticResource ChatMeta}" FontSize="10" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="较早的对话已经整理成备忘，只发给模型；屏幕上不显示备忘正文"
                                   Visibility="{Binding HasMemo, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CompactButton" Content="压缩上下文" Command="{Binding CompactCommand}"
                                Style="{StaticResource TopBarButton}" Padding="{StaticResource PadButtonSmall}" Margin="0,0,8,0" />
                        <Button Content="请主持人开场" Command="{Binding OpeningSpeechCommand}"
                                Style="{StaticResource TopBarButton}" Padding="{StaticResource PadButtonSmall}"
                                Visibility="{Binding ShowOpeningSpeech, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
