<UserControl x:Class="LocalDm.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左：节目单主栏 ============ -->
        <Grid Grid.Column="0" Margin="34,26,26,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 环节：压印大字 + 章标进度 -->
            <StackPanel Grid.Row="0" DataContext="{Binding Session}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PhaseTitle, Mode=OneWay}" Style="{StaticResource Display}" />
                        <TextBlock Text="{Binding SessionStateLabel, Mode=OneWay}" Margin="0,6,0,0"
                                   FontSize="13" Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Revision, Mode=OneWay, StringFormat=第 {0} 次提交}"
                                   Style="{StaticResource Figure}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource Rule}" Margin="0,16,0,0" />
                <Border Height="1" Background="{StaticResource Rule}" Margin="0,3,0,0" />

                <!-- 阶段章标：七个阶段，当前阶段实心 -->
                <ItemsControl ItemsSource="{Binding PhaseRail}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,6,0">
                                <Border Height="4" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Rule}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource InkSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Seal}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,7,0,0"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Seal}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 操作条 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,16">
                <Button x:Name="SpeakButton" Content="公共开场" Command="{Binding SpeakCommand}"
                        Style="{StaticResource SealButton}" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="停止" Command="{Binding StopCommand}" Style="{StaticResource QuietButton}" />
                <Button x:Name="ReplayButton" Content="重播" Command="{Binding ReplayCommand}" Style="{StaticResource QuietButton}" />
                <Button x:Name="LoadDemoButton" Content="装载演示剧本" Command="{Binding LoadDemoCommand}" Style="{StaticResource QuietButton}" />
            </StackPanel>

            <!-- 主持记录：不是聊天，是场记 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                    Background="{StaticResource PaperDim}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <TextBlock Text="主持记录" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkSoft}" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                   Style="{StaticResource Figure}" Margin="0,3,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="15" LineHeight="25" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 实时互动：随时插话的唯一入口，视觉上独立于流程按钮 -->
            <Border Grid.Row="3" Grid.RowSpan="2" Background="{StaticResource PaperDeep}"
                    BorderBrush="{StaticResource Ink}" BorderThickness="1" Padding="18,14,18,16"
                    Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Seal}" Padding="8,2" CornerRadius="1">
                            <TextBlock Text="实时互动" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Paper}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="随时问主持人：规则、当前环节、怎么投票"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />
                    </Grid>

                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="OnInputPreviewKeyDown" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SendButton" Grid.Column="0" Content="发送并朗读"
                                Command="{Binding SendCommand}"
                                Style="{StaticResource SealButton}" Padding="28,12" Margin="0" />
                        <TextBlock Grid.Column="1" Text="回车发送 · Shift+Enter 换行 · 中文组合输入不误发"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 右：本环节条件与操作 ============ -->
        <Border Grid.Column="1" Background="{StaticResource PaperDeep}"
                BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                        Padding="24,22,24,18">
                    <StackPanel>
                        <TextBlock Text="本环节" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkSoft}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontSize="13" Foreground="{StaticResource InkSoft}" LineHeight="21" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,18,18">
                    <StackPanel DataContext="{Binding Session}">
                        <TextBlock Text="原本条件" Style="{StaticResource SectionRule}" />
                        <ItemsControl ItemsSource="{Binding PhaseConditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="·" Foreground="{StaticResource Seal}"
                                                   FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                   FontSize="14" LineHeight="22" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="已发放材料编号" Style="{StaticResource SectionRule}" />
                        <ItemsControl ItemsSource="{Binding ReleasedMaterials}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}"
                                            BorderThickness="1" Padding="9,4" Margin="0,0,6,6" CornerRadius="1">
                                        <TextBlock Text="{Binding}" FontSize="13" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource Rule}" Margin="0,14,0,0" />

                        <CheckBox x:Name="GroupReadyBox" Content="大家已口头准备好"
                                  IsChecked="{Binding GroupReady, Mode=TwoWay}" Margin="0,14,0,12" />

                        <Button x:Name="StartButton" Content="开始这一局"
                                Command="{Binding StartCommand}" Style="{StaticResource SealButton}"
                                IsEnabled="{Binding CanStart}" />
                        <Button x:Name="AdvanceButton" Content="下一环节"
                                Command="{Binding AdvanceCommand}"
                                IsEnabled="{Binding CanAdvance}" />
                        <Button x:Name="ReleaseButton" Content="发放一个材料编号"
                                Command="{Binding ReleaseMaterialsCommand}"
                                IsEnabled="{Binding CanReleaseMaterials}" />

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PauseButton" Grid.Column="0" Content="暂停并保存"
                                    Command="{Binding PauseCommand}" Margin="0,0,4,0"
                                    IsEnabled="{Binding CanPause}" />
                            <Button x:Name="ResumeButton" Grid.Column="1" Content="继续（恢复）"
                                    Command="{Binding ResumeCommand}" Margin="4,0,0,0"
                                    Click="OnResumeClick" IsEnabled="{Binding CanResume}" />
                        </Grid>

                        <TextBlock Text="纸笔汇总" Style="{StaticResource SectionRule}" />
                        <TextBlock Text="格式 A=3, B=2" Style="{StaticResource Figure}" Margin="0,0,0,6" />
                        <TextBox x:Name="VoteBox" Text="{Binding VoteInput, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />
                        <CheckBox x:Name="VoteConfirmBox" Content="确认这是大家核对过的汇总"
                                  IsChecked="{Binding VoteConfirmed, Mode=TwoWay}" Margin="0,0,0,10" />
                        <Button x:Name="VoteButton" Content="提交票数汇总"
                                Command="{Binding SubmitVoteCommand}"
                                IsEnabled="{Binding CanSubmitVote}" />

                        <TextBlock Text="揭秘" Style="{StaticResource SectionRule}" />
                        <CheckBox x:Name="RevealConfirm"
                                  IsChecked="{Binding RevealConfirmed, Mode=TwoWay}"
                                  Margin="0,0,0,10">
                            <TextBlock Text="确认这是公开揭秘，且原本条件已满足" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button x:Name="RevealButton" Content="揭秘"
                                Command="{Binding RevealCommand}" Style="{StaticResource SealButton}"
                                IsEnabled="{Binding CanReveal}" />
                        <Button x:Name="CompleteButton" Content="进入复盘"
                                Command="{Binding CompleteCommand}"
                                IsEnabled="{Binding CanComplete}" />

                        <TextBlock Text="{Binding Status}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 揭秘内容：像节目单末尾盖上的印章页 -->
                <Border Grid.Row="2" Background="{StaticResource Cloth}" Padding="24,16,18,16"
                        MaxHeight="300"
                        Visibility="{Binding Session.HasRevealedText, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="已公开的揭秘" FontSize="11" Foreground="#FFB3A78E" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
                            <TextBlock Text="{Binding Session.RevealedText}" TextWrapping="Wrap"
                                       FontSize="14" LineHeight="23" Foreground="{StaticResource Paper}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
