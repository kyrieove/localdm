<UserControl x:Class="LocalDm.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,38,44,36" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="设置与诊断" Style="{StaticResource Display}" />
            <TextBlock Text="所有检测都只在点击后执行。首版只连接本机 loopback 模型地址。"
                       Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,3,0,24" />

            <!-- 模型 -->
            <Border Style="{StaticResource PaperPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="文字模型" Style="{StaticResource DisplaySmall}" FontSize="18" />
                    <TextBlock Text="Windows Magpie，本机 loopback" Margin="0,4,0,16"
                               FontSize="12" Foreground="{StaticResource Muted}" />

                    <TextBlock Text="模型地址" Style="{StaticResource SectionRule}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MagpieBaseUri, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="读取模型列表" Command="{Binding CheckConnectionCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />

                    <TextBlock Text="model ID（来自实际列表，不按显示名猜测）"
                               Style="{StaticResource SectionRule}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding ModelId, Mode=TwoWay}"
                              IsEditable="True" />

                    <TextBlock Text="{Binding CallerKeyState}" Margin="0,16,0,0"
                               FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />
                    <PasswordBox x:Name="CallerKeyBox" Margin="0,8,0,8" PasswordChanged="OnCallerKeyChanged" />
                    <Button Content="加密保存 caller key" Command="{Binding SaveCallerKeyCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 声音 -->
            <Border Style="{StaticResource PaperPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="中文声音" Style="{StaticResource DisplaySmall}" FontSize="18" />
                    <TextBlock Text="Windows System.Speech" Margin="0,4,0,16"
                               FontSize="12" Foreground="{StaticResource Muted}" />

                    <ComboBox ItemsSource="{Binding AvailableVoices}" DisplayMemberPath="Name"
                              SelectedValuePath="Name" SelectedValue="{Binding VoiceId, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="重新检测声音" Command="{Binding CheckVoicesCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="试听" Command="{Binding PreviewVoiceCommand}" Margin="0" />
                    </StackPanel>

                    <TextBlock Text="自包含发布不包含系统声音；缺失时只显示文字并报告 TTS_UNAVAILABLE。"
                               Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 文档工具 -->
            <Border Style="{StaticResource PaperPanel}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="文档工具" Style="{StaticResource DisplaySmall}" FontSize="18" />
                    <TextBlock Text="MinerU 4.0.1，仅准备阶段使用" Margin="0,4,0,16"
                               FontSize="12" Foreground="{StaticResource Muted}" />

                    <TextBlock Text="可执行文件绝对路径" Style="{StaticResource SectionRule}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MineruExecutable, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="正式游玩读取冻结包，不要求 MinerU 服务运行。"
                               Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource SealButton}"
                    HorizontalAlignment="Left" Padding="26,13" Margin="0" />
            <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap"
                       FontSize="13" Foreground="{StaticResource InkSoft}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
