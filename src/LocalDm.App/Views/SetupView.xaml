<UserControl x:Class="LocalDm.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LocalDm.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,34,34,34" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="偏好设置" Style="{StaticResource Display}" FontSize="26" />
            <TextBlock Text="声音与模型，在这里设置一次就好。所有检测都只在点击后执行。"
                       Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,22,0,0" />

            <Border x:Name="TabletConnectionSection" DataContext="{Binding Tablet}" Padding="18" Margin="0,22,0,0"
                    Background="{StaticResource PaperDeep}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="平板服务（高级）" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="平板入口与二维码在剧本库页顶部；这里只用来关闭或重新开启服务。" Style="{StaticResource ChatMeta}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="TabletConnectionToggle" Grid.Column="1" Content="{Binding ToggleLabel}"
                                Command="{Binding ToggleCommand}" Style="{StaticResource QuietButton}" Padding="16,8" />
                    </Grid>
                    <TextBlock x:Name="TabletConnectionStatus" Text="{Binding Status}" TextWrapping="Wrap"
                               Style="{StaticResource ChatMeta}" Margin="0,12,0,0" />
                    <Grid Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0" VerticalAlignment="Center">
                            <TextBlock Text="电脑和平板连同一个 Wi-Fi 后，扫码或打开下面的网址。" TextWrapping="Wrap" />
                            <ComboBox x:Name="TabletAddressSelector" ItemsSource="{Binding Addresses}"
                                      SelectedItem="{Binding SelectedAddress}" Margin="0,12,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="电脑打开" Command="{Binding OpenCommand}" Style="{StaticResource QuietButton}" Padding="12,6" Margin="0,0,8,0" />
                                <Button Content="复制网址" Command="{Binding CopyCommand}" Style="{StaticResource QuietButton}" Padding="12,6" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 声音 ===== -->
            <TextBlock Text="声音" Style="{StaticResource RailLabel}" Margin="0,26,0,4" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="主持音色" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="回复生成后，用这位主持人的声音朗读。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="VoiceSelector" ItemsSource="{Binding AvailableVoices}"
                              SelectedValuePath="Name" SelectedValue="{Binding VoiceId, Mode=TwoWay}"
                              Width="230" Height="32" VerticalContentAlignment="Center"
                              ToolTip="鼠标悬停可看音色说明">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="PreviewVoiceButton" Content="试听" Command="{Binding PreviewVoiceCommand}"
                            Style="{StaticResource QuietButton}" Padding="14,7" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="自动朗读回复" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="关闭后只显示文字，仍可在每条回复旁单独重播。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <CheckBox x:Name="AutoReadBox" Grid.Column="1" IsChecked="{Binding AutoRead, Mode=TwoWay}"
                          VerticalAlignment="Center" Content="回复后自动朗读" />
            </Grid>

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="声音输出" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="跟随 Windows 默认输出设备，本软件不单独选择设备。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="使用系统设置" Style="{StaticResource ChatMeta}"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="声音可用性" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="本机装了哪些中文声音。缺失时只显示文字，不静默改成英文音色。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="重新检测声音" Command="{Binding CheckVoicesCommand}"
                        Style="{StaticResource QuietButton}" Padding="14,7" VerticalAlignment="Center" />
            </Grid>

            <!-- ===== 模型 ===== -->
            <TextBlock Text="模型" Style="{StaticResource RailLabel}" Margin="0,30,0,4" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="主持模型" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="从实际读取到的 model ID 里选，不按显示名猜。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ModelSelector" ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding ModelId, Mode=TwoWay}" IsEditable="True"
                              Width="260" Height="32" VerticalContentAlignment="Center" />
                    <Button x:Name="ListModelsButton" Content="读取列表" Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource QuietButton}" Padding="14,7" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
                <controls:ActivityDots VerticalAlignment="Center" Margin="0,0,10,0"
                                        IsAnimating="True" DotBrush="{StaticResource Seal}" />
                <TextBlock Text="正在连接本机模型服务…" VerticalAlignment="Center"
                           Style="{StaticResource ChatMeta}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="模型上下文长度（tokens）" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="按所用模型的官方上下文长度填写；不确定就保留默认值。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <TextBox x:Name="ContextWindowBox" Grid.Column="1"
                         Text="{Binding ContextWindowTokens, UpdateSourceTrigger=PropertyChanged}"
                         Width="260" MinHeight="34" VerticalContentAlignment="Center" />
            </Grid>

            <!-- 界面缩放：与 Ctrl+加号 / Ctrl+减号 / Ctrl+滚轮是同一个值 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="界面缩放" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding UiScaleHint}" Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <Slider x:Name="UiScaleSlider" Grid.Column="1" Width="260" Height="32"
                        VerticalAlignment="Center"
                        Minimum="0.8" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding UiScale, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 对话宽度：标准 / 宽 / 满宽 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="对话宽度" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="满宽只留两端边距；换档立即生效。"
                               Style="{StaticResource ChatMeta}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ChatWidthStandard" Content="标准" GroupName="ChatWidth" Margin="0,0,14,0"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{StaticResource Ink}"
                                 IsChecked="{Binding IsChatWidthStandard, Mode=TwoWay}" />
                    <RadioButton x:Name="ChatWidthWide" Content="宽" GroupName="ChatWidth" Margin="0,0,14,0"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{StaticResource Ink}"
                                 IsChecked="{Binding IsChatWidthWide, Mode=TwoWay}" />
                    <RadioButton x:Name="ChatWidthFull" Content="满宽" GroupName="ChatWidth"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Foreground="{StaticResource Ink}"
                                 IsChecked="{Binding IsChatWidthFull, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- 高级：连接与鉴权 -->
            <Expander Margin="0,20,0,0" Foreground="{StaticResource InkSoft}">
                <Expander.Header>
                    <TextBlock Text="高级连接设置" FontSize="13" Foreground="{StaticResource Muted}" />
                </Expander.Header>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="本机服务地址" Style="{StaticResource RailLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="ModelAddressBox"
                             Text="{Binding MagpieBaseUri, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="首版只允许本机 loopback 地址；换地址后需要重新读取模型列表。"
                               Style="{StaticResource ChatMeta}" Margin="0,8,0,0" />
                    <Button Content="重新检测连接" Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                            Padding="14,7" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding CallerKeyState}" Style="{StaticResource ChatMeta}"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Expander>

            <!-- 高级：剧本准备工具（不属于游玩界面） -->
            <Expander Margin="0,6,0,0" Foreground="{StaticResource InkSoft}">
                <Expander.Header>
                    <TextBlock Text="高级：剧本准备" FontSize="13" Foreground="{StaticResource Muted}" />
                </Expander.Header>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="文档工具可执行文件路径" Style="{StaticResource RailLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="MineruBox"
                             Text="{Binding MineruExecutable, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="只在准备剧本时使用。正式游玩读取冻结好的剧本包，不要求这个工具运行。"
                               Style="{StaticResource ChatMeta}" Margin="0,8,0,0" />

                    <TextBlock Text="备用 OCR 的 Python 解释器" Style="{StaticResource RailLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="OcrPythonBox"
                             Text="{Binding OcrPythonPath, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="留空时依次使用环境变量 LOCALDM_OCR_PYTHON 与 python。只在导入剧本时用到。"
                               Style="{StaticResource ChatMeta}" Margin="0,8,0,0" />
                </StackPanel>
            </Expander>

            <!-- 高级：主持提示词，只读，方便对照和复制 -->
            <Expander Margin="0,6,0,0" Foreground="{StaticResource InkSoft}">
                <Expander.Header>
                    <TextBlock Text="高级：主持提示词（只读）" FontSize="13" Foreground="{StaticResource Muted}" />
                </Expander.Header>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="主持人固定提示词" Style="{StaticResource RailLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="HostPromptBox" Text="{Binding HostPromptText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="360" FontSize="13"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="开局时把「{剧本名}」「{人数}」换成实际值。每轮还会附上剧本资料和当前局面，这里不显示，免得剧透。"
                               Style="{StaticResource ChatMeta}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="导入时起草流程的提示词" Style="{StaticResource RailLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="FlowPromptBox" Text="{Binding FlowDraftPromptText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="360" FontSize="13"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>

            <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource SealButton}"
                    HorizontalAlignment="Left" Padding="26,12" Margin="0,26,0,0" />
            <TextBlock Text="{Binding Status}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Style="{StaticResource ChatMeta}" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
