<UserControl x:Class="LocalDm.App.Views.ImportWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        导入向导全程不显示剧本正文、卡面、真相或缩略图：
        ② 页只有分组名、相对路径、页数、文件类型与猜测依据；
        ④ 页只有流程与页号，带剧情的提示显示「已隐藏」。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,34,34,30" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="导入新剧本" Style="{StaticResource Display}" FontSize="26" />
            <TextBlock Text="{Binding StepLabel}" Style="{StaticResource RailLabel}" Margin="0,8,0,0" />
            <TextBlock Text="导入全程不显示剧本正文与卡面：如果这局的玩家就是你自己，也不会被剧透。"
                       Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,20,0,0" />

            <!-- ===== ① 选文件夹 ===== -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding IsFolderStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="剧本文件夹" Style="{StaticResource RailLabel}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                             Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="选择文件夹"
                            Click="OnChooseFolder" Style="{StaticResource QuietButton}"
                            Padding="16,8" Margin="10,0,0,0" />
                </Grid>

                <TextBlock Text="剧本名" Style="{StaticResource RailLabel}" Margin="0,16,0,6" />
                <TextBox x:Name="TitleBox" Height="34" VerticalContentAlignment="Center"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="玩家人数（4–6）" Style="{StaticResource RailLabel}" Margin="0,16,0,6" />
                <TextBox x:Name="PlayerCountBox" Width="90" Height="34" HorizontalAlignment="Left"
                         VerticalContentAlignment="Center"
                         Text="{Binding PlayerCount, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- ===== ② 分类确认 ===== -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding IsGroupsStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="每个分组一行：名字、相对路径、页数、文件类型、软件猜的类别与依据。"
                           Style="{StaticResource ChatMeta}" />
                <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource ChatMeta}"
                                                   FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding GuessReason}" Style="{StaticResource ChatMeta}"
                                                   FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                              ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Kind, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== ③ 识别 ===== -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding IsExtractingStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressText}" FontSize="17"
                           Foreground="{StaticResource Ink}" />
                <TextBlock Text="{Binding EstimatedRemainingText}" Style="{StaticResource ChatMeta}"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="FailedPagesLabel" Text="{Binding FailedPagesText}"
                           Style="{StaticResource ChatMeta}" Margin="0,6,0,0"
                           Foreground="{StaticResource Seal}" />
                <TextBlock Text="识别的是图片里的文字，界面上不会显示识别结果。"
                           Style="{StaticResource ChatMeta}" Margin="0,12,0,0" />
                <Button x:Name="CancelExtractionButton" Content="取消识别"
                        Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left" Padding="16,8" Margin="0,16,0,0" />
            </StackPanel>

            <!-- ===== ④ 流程确认 ===== -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding IsFlowStep, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource SealWash}" BorderBrush="#FFD8C8A7" BorderThickness="1"
                        CornerRadius="6" Padding="14,10">
                    <TextBlock x:Name="FlowNoticeLabel" Text="{Binding FlowNotice}" FontSize="12"
                               Foreground="#FF6B5637" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="LayeringSummaryLabel" Text="{Binding LayeringSummary}"
                           Style="{StaticResource ChatMeta}" Margin="0,14,0,0" TextWrapping="Wrap" />

                <ItemsControl x:Name="FlowStepList" ItemsSource="{Binding FlowSteps}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" MinHeight="30" Padding="6,4"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayHint}" Style="{StaticResource ChatMeta}"
                                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding ConditionsText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Padding="6,4" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SourceRefDisplay}"
                                                       Style="{StaticResource ChatMeta}" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" Width="120"
                                                  SelectedValue="{Binding Kind, Mode=TwoWay}" />
                                        <Button Content="上移" Style="{StaticResource TopBarButton}"
                                                Padding="8,3" Margin="0,6,0,0" Click="OnMoveUp" />
                                        <Button Content="下移" Style="{StaticResource TopBarButton}"
                                                Padding="8,3" Margin="0,4,0,0" Click="OnMoveDown" />
                                        <Button Content="删除" Style="{StaticResource TopBarButton}"
                                                Padding="8,3" Margin="0,4,0,0" Click="OnDeleteStep" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="AddStepButton" Content="加一个环节" Command="{Binding AddStepCommand}"
                        Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                        Padding="16,8" Margin="0,12,0,0" />

                <TextBlock Text="手册分层（只显示页号，不显示内容）" Style="{StaticResource RailLabel}"
                           Margin="0,18,0,6" />
                <ItemsControl x:Name="LayeringPageList" ItemsSource="{Binding LayeringPages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource ChatMeta}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding LayerOptions}"
                                          SelectedItem="{Binding Layer, Mode=TwoWay}" Width="110" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== ⑤ 完成 ===== -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="ReadinessLabel" Text="{Binding ReadinessText}" FontSize="16"
                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                <Button x:Name="OpenBuiltButton" Content="打开这一本"
                        Command="{Binding OpenBuiltCommand}" Style="{StaticResource SealButton}"
                        HorizontalAlignment="Left" Padding="24,12" Margin="0,18,0,0" />
            </StackPanel>

            <!-- ===== 底部：上一步 / 下一步 / 状态 ===== -->
            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="上一步"
                        Command="{Binding BackCommand}" Style="{StaticResource QuietButton}"
                        Padding="18,9" Margin="0,0,10,0" />
                <Button x:Name="NextButton" Grid.Column="1" Content="下一步"
                        Command="{Binding NextCommand}" Style="{StaticResource SealButton}"
                        Padding="22,10" Margin="0,0,10,0" />
                <Button x:Name="CloseWizardButton" Grid.Column="2" Content="回到剧本库"
                        Click="OnClose" Style="{StaticResource QuietButton}"
                        Padding="18,9" Margin="0,0,16,0" />
                <TextBlock x:Name="StatusLabel" Grid.Column="3" Text="{Binding Status}"
                           VerticalAlignment="Center" Style="{StaticResource ChatMeta}" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
