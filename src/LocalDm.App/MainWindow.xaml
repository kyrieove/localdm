<Window x:Class="LocalDm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalDm.App.ViewModels"
        xmlns:views="clr-namespace:LocalDm.App.Views"
        Title="绘合·Paletale" Icon="Assets/app.ico" Height="860" Width="1360" MinHeight="560" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="15"
        Foreground="{DynamicResource Ink}"
        Background="{DynamicResource Paper}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LocalDm;component/Themes/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                <views:LibraryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SetupViewModel}">
                <views:SetupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HostViewModel}">
                <views:HostView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportWizardViewModel}">
                <views:ImportWizardView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="UiScaleRoot" SizeChanged="OnRootSizeChanged">
        <!--
            整窗缩放：放在内容根的 LayoutTransform 上，布局跟着一起缩放，
            放大后按钮与左栏才会落到真实的可用范围里。
        -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            ===== 导航栏（平板 NavigationRail 的样子）=====
            顶上是环节表盘，中间是去哪一页，底部是停止与平板入口。
            窗口变矮、缩放变大时整栏滚动，底部的按钮不能被裁掉。
        -->
        <Border Grid.Column="0" Width="84" Background="{StaticResource PaperDeep}">
            <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 边距放在两组按钮上，不放在这个 Grid 上：它和视口一样高，再加边距就永远多出一截要滚 -->
                <Grid MinHeight="{Binding ViewportHeight, ElementName=RailScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,18,0,0">
                        <!-- 环节表盘：一眼看到第几环；点它收起或展开环节面板 -->
                        <Button x:Name="PhaseDial" Click="OnDialClick" Margin="0,0,0,22" Cursor="Hand"
                                AutomationProperties.Name="环节面板" ToolTip="收起或展开环节面板"
                                Visibility="{Binding IsHostActive, Converter={StaticResource BoolToVisibility}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Background="Transparent">
                                        <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                            <Ellipse Stroke="{StaticResource Rule}" StrokeThickness="4" Margin="1" />
                                            <Path Stroke="{StaticResource Seal}" StrokeThickness="4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{Binding Host.Session.PhaseFraction, Converter={StaticResource ProgressArc}}" />
                                            <TextBlock Text="{Binding Host.Session.PhaseProgress}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource Ink}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Host.Session.PhaseTitle}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Seal}" Margin="6,6,6,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="NavLibrary" Content="&#xE8F1;" AutomationProperties.Name="剧本库"
                                Style="{StaticResource NavRailButton}" Tag="{Binding IsLibraryActive}"
                                Command="{Binding ShowLibraryCommand}" />
                        <Button x:Name="NavSession" Content="&#xE8BD;" AutomationProperties.Name="本局"
                                Style="{StaticResource NavRailButton}" Tag="{Binding IsHostActive}"
                                Command="{Binding ShowHostCommand}"
                                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="NavSetup" Content="&#xE713;" AutomationProperties.Name="设置"
                                Style="{StaticResource NavRailButton}" Tag="{Binding IsSetupActive}"
                                Command="{Binding ShowSetupCommand}"
                                ToolTip="{Binding ModelStatusLine}" />
                        <TextBlock Text="未选模型" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SealDeep}" Margin="0,-6,0,10"
                                   Visibility="{Binding IsModelMissing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" DataContext="{Binding Host}" Margin="0,0,0,14">
                        <!--
                            停止放在导航栏而不是输入区里：生成或播音期间可能已经切到
                            「公开材料与复盘」或设置页，那时输入区是折叠的，只在输入区放停止键就找不到它。
                        -->
                        <Button x:Name="RailStopButton" Content="&#xE71A;" AutomationProperties.Name="停止"
                                Style="{StaticResource NavRailButton}" Command="{Binding StopCommand}"
                                ToolTip="停止生成或朗读，游戏进度不变"
                                Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="NavTablet" Content="&#xED14;" AutomationProperties.Name="平板"
                                Style="{StaticResource NavRailButton}" Click="OnTabletEntryClick" Margin="0"
                                ToolTip="{Binding DataContext.Library.Tablet.SelectedAddress,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  TargetNullValue=点开看大二维码，平板扫码加入}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!--
            ===== 环节面板 =====
            只管「现在到哪、还差什么、我能做什么」。主持人要常按这里的动作，所以宽屏时常开；
            窗口窄时自动收起，点表盘再展开。动作钉在底部：只让上面的进度滚动，按钮不能被滚出屏幕。
        -->
        <Border x:Name="PhasePanel" Grid.Column="1" Width="288" ClipToBounds="True"
                Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0"
                DataContext="{Binding Host}"
                Visibility="{Binding DataContext.IsHostActive,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolToVisibility}}">
            <Grid Width="287" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="PhasePanelScroll" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,22,18,8">
                        <TextBlock Text="{Binding Session.PublicTitle}" Style="{StaticResource RailTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                            <TextBlock Text="{Binding Session.PlayerCount, StringFormat={}{0} 位玩家}"
                                       Style="{StaticResource RailLabel}" />
                            <TextBlock Text=" · " Style="{StaticResource RailLabel}" />
                            <TextBlock Text="{Binding Session.SessionStateLabel}" Style="{StaticResource RailLabel}" />
                        </StackPanel>

                        <!-- 环节列表：走过的打勾，当前的琥珀圆，没到的只有序号（平板环节面板的样子） -->
                        <ItemsControl x:Name="PhaseRail" ItemsSource="{Binding Session.PhaseRail}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Badge" Width="28" Height="28" CornerRadius="14"
                                                HorizontalAlignment="Left" Background="Transparent">
                                            <Grid>
                                                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="13"
                                                           Foreground="{StaticResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12"
                                                           Foreground="{StaticResource InkSoft}" Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                                   Foreground="{StaticResource InkSoft}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                                   Foreground="{StaticResource Seal}" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource AvatarWash}" />
                                            <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Ink}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Seal}" />
                                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource OnSeal}" />
                                            <Setter TargetName="Num" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Ink}" />
                                            <Setter TargetName="Title" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 当前流程提示：灯泡 + 剧本给的那一句 -->
                        <Border Background="{StaticResource Bubble}" CornerRadius="12" Padding="14,12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="16"
                                           Foreground="{StaticResource Seal}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PhaseHint" Text="{Binding Session.Hint}" FontSize="13" LineHeight="21"
                                               Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Session.PhaseConditions}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource ChatMeta}" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 可用动作：点一下就是确认 ===== -->
                <StackPanel Grid.Row="1" Margin="22,10,18,18">
                    <Button x:Name="StartButton" Content="{Binding Session.StartLabel}"
                            Command="{Binding Session.StartCommand}"
                            Style="{StaticResource SealButton}" Padding="14,11" Margin="0,0,0,8"
                            IsEnabled="{Binding Session.CanStart}"
                            Visibility="{Binding Session.IsStartVisible, Converter={StaticResource BoolToVisibility}}" />

                    <Button x:Name="AdvanceButton" Content="{Binding Session.AdvanceLabel}"
                            Command="{Binding Session.AdvanceCommand}"
                            Style="{StaticResource SealButton}" Padding="14,11" Margin="0,0,0,8"
                            IsEnabled="{Binding Session.CanAdvance}"
                            Visibility="{Binding Session.IsAdvanceVisible, Converter={StaticResource BoolToVisibility}}" />

                    <Button x:Name="OpeningSpeechButton" Content="请主持人开场"
                            Command="{Binding OpeningSpeechCommand}"
                            Padding="14,9" Margin="0,0,0,8"
                            Visibility="{Binding ShowOpeningSpeech, Converter={StaticResource BoolToVisibility}}" />

                    <Button x:Name="ReleaseButton" Content="{Binding Session.ReleaseLabel}"
                            Command="{Binding Session.ReleaseMaterialsCommand}"
                            Padding="14,9" Margin="0,0,0,8"
                            IsEnabled="{Binding Session.CanReleaseMaterials}"
                            Visibility="{Binding Session.IsReleaseVisible, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Session.PendingMaterialSummary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource Seal}" />
                                <Setter Property="Margin" Value="2,0,0,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.PendingMaterialSummary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 投票：只有剧本有投票时才出现；点提交即确认，不再勾选 -->
                    <StackPanel Margin="0,0,0,8"
                                Visibility="{Binding Session.IsVoteVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="纸笔投票汇总 · 格式 A=3, B=2" Style="{StaticResource RailLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="VoteBox"
                                 AutomationProperties.AutomationId="VoteBox"
                                 Text="{Binding Session.VoteInput, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Session.VoteHint}" Style="{StaticResource ChatMeta}" Margin="0,0,0,6" />
                        <Button x:Name="VoteButton" Content="{Binding Session.SubmitVoteLabel}"
                                Command="{Binding Session.SubmitVoteCommand}"
                                Style="{StaticResource SealButton}" Padding="14,11"
                                IsEnabled="{Binding Session.CanSubmitVote}" />
                    </StackPanel>

                    <Border Background="{StaticResource PaperDim}" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding Session.HasVoteSummary, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Session.VoteSummaryDisplay}" Style="{StaticResource ChatMeta}" />
                    </Border>

                    <!-- 揭秘：按钮旁直接说清后果（点击即确认，见 SessionViewModel.RevealWarning） -->
                    <StackPanel Margin="0,0,0,8"
                                Visibility="{Binding Session.IsRevealVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Session.RevealWarning}" Style="{StaticResource ChatMeta}"
                                   FontSize="12" Foreground="{StaticResource SealDeep}" Margin="2,0,0,6" />
                        <Button x:Name="RevealButton" Content="{Binding Session.RevealLabel}"
                                Command="{Binding Session.RevealCommand}"
                                Style="{StaticResource SealButton}" Padding="14,11"
                                IsEnabled="{Binding Session.CanReveal}" />
                    </StackPanel>

                    <Button x:Name="CompleteButton" Content="{Binding Session.CompleteLabel}"
                            Command="{Binding Session.CompleteCommand}"
                            Style="{StaticResource SealButton}" Padding="14,11" Margin="0,0,0,8"
                            IsEnabled="{Binding Session.CanComplete}"
                            Visibility="{Binding Session.IsCompleteVisible, Converter={StaticResource BoolToVisibility}}" />

                    <Button x:Name="PauseResumeButton" Content="{Binding Session.PauseResumeLabel}"
                            Command="{Binding Session.PauseResumeCommand}"
                            Style="{StaticResource QuietButton}" Padding="14,9" Margin="0,0,0,6"
                            IsEnabled="{Binding Session.CanPauseResume}"
                            Visibility="{Binding Session.IsPauseResumeVisible, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Session.ActionHint}" Style="{StaticResource ChatMeta}" Margin="2,0,0,0" />

                    <!-- 命令被拒绝时的原因就地显示，不弹窗；成功回执用普通字色 -->
                    <TextBlock x:Name="SessionStatus" Text="{Binding Session.Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ChatMeta}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource SealDeep}" />
                                <Setter Property="Margin" Value="2,6,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.StatusIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 重新开始不可撤销：放在动作区最末、离主按钮最远；点了从底部滑出确认面板（见窗口最上层的 RestartSheet） -->
                    <Button x:Name="RestartButton" Content="重新开始本局"
                            Command="{Binding Session.RestartCommand}"
                            Style="{StaticResource TopBarButton}" HorizontalAlignment="Left" Margin="-10,12,0,0"
                            IsEnabled="{Binding Session.CanRestart}"
                            Visibility="{Binding Session.IsRestartVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区：对话 / 公开材料 / 剧本库 / 设置 -->
        <Border Grid.Column="2" Background="{StaticResource Paper}">
            <ContentControl Content="{Binding Current}" />
        </Border>

        <!--
            ===== 重新开始的确认面板 =====
            不可撤销，所以从底部滑出、背景压暗；点暗处等于取消。
            放在 UiScaleRoot 里面横跨三列：跟着整窗缩放一起变大。
        -->
        <Grid x:Name="RestartSheet" Grid.ColumnSpan="3" DataContext="{Binding Host.Session}"
              Visibility="{Binding IsRestartConfirming, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource Scrim}" MouseLeftButtonDown="OnScrimClick" />
            <Border x:Name="RestartSheetCard" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Width="560" MaxWidth="{Binding ActualWidth, ElementName=UiScaleRoot}"
                    Background="{StaticResource PaperDim}" CornerRadius="28,28,0,0" Padding="28,12,28,28"
                    Effect="{StaticResource SheetShadow}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                             From="120" To="0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Width="36" Height="4" CornerRadius="2" Background="{StaticResource Silver}" Margin="0,0,0,20" />
                    <TextBlock Text="重新开始本局？" Style="{StaticResource DisplaySmall}" />
                    <TextBlock Text="{Binding RestartWarning}" FontSize="14" LineHeight="23" TextWrapping="Wrap"
                               Foreground="{StaticResource InkSoft}" Margin="0,10,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="取消" Command="{Binding CancelRestartCommand}"
                                Style="{StaticResource QuietButton}" Padding="14,11" Margin="0" />
                        <Button x:Name="ConfirmRestartButton" Grid.Column="2" Content="确认重来"
                                Command="{Binding ConfirmRestartCommand}"
                                Style="{StaticResource SealButton}" Padding="14,11" Margin="0"
                                IsEnabled="{Binding CanRestart}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
