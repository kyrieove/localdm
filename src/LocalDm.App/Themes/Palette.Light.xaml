<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 「灯下」浅色：白天和亮房间用，同一套色相；值取自平板 theme.dart 的 Palette.light。键名含义见 Palette.Dark.xaml。 -->
    <SolidColorBrush x:Key="Paper" Color="#FFFAF7F2" />
    <SolidColorBrush x:Key="PaperDeep" Color="#FFF4F0E9" />
    <SolidColorBrush x:Key="PaperDim" Color="#FFEFEAE2" />
    <SolidColorBrush x:Key="Bubble" Color="#FFE9E3DA" />
    <SolidColorBrush x:Key="AvatarWash" Color="#FFE2DCD2" />
    <SolidColorBrush x:Key="Ink" Color="#FF1F1B16" />
    <SolidColorBrush x:Key="InkSoft" Color="#FF575045" />
    <SolidColorBrush x:Key="Muted" Color="#FF645D51" />
    <SolidColorBrush x:Key="Rule" Color="#FFD3CCC0" />
    <SolidColorBrush x:Key="Silver" Color="#FF7D7567" />
    <SolidColorBrush x:Key="Seal" Color="#FF7A4A00" />
    <SolidColorBrush x:Key="SealHover" Color="#FF8F5A0A" />
    <SolidColorBrush x:Key="OnSeal" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SealWash" Color="#FFFFDDB0" />
    <SolidColorBrush x:Key="OnSealWash" Color="#FF2B1C05" />
    <SolidColorBrush x:Key="SealDeep" Color="#FFB3261E" />
    <SolidColorBrush x:Key="ErrorWash" Color="#FFF9DEDC" />
    <SolidColorBrush x:Key="Scrim" Color="#80000000" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#667D7567" />
    <Color x:Key="ShadowColor">#FF5B4A30</Color>

</ResourceDictionary>
