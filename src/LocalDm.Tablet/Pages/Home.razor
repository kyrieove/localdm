@page "/"
@using LocalDm.Core.Tablet
@using LocalDm.Tablet
@inject TabletSpikeState State
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IPublicFeedSource Feed
@inject TabletSpeechService Speech
@inject ITabletUiSource Ui
@implements IAsyncDisposable
@* 交互渲染模式必须显式声明：只注册 AddInteractiveServerComponents 不会让按钮生效。 *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@{
    // 没有会话 Cookie 时现场发一个：每台设备各拿各的键。
    var session = State.Session(_sessionKey);
}

<div class="shell">
    <header class="shell-bar @(InWorkspace ? "has-tabs" : "")">
        <div class="shell-title">
            <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
                <rect x="2" y="2" width="60" height="60" rx="12" fill="currentColor" />
                <g fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round">
                    <path d="M32 12 50.2 22.5v21L32 54 13.8 43.5v-21Z" />
                    <path d="M32 22.5 42.5 40.6h-21Z" />
                    <path stroke-width="2" d="M32 12v10.5M50.2 22.5 32 22.5M50.2 22.5 42.5 40.6M50.2 43.5 42.5 40.6M32 54l10.5-13.4M32 54 21.5 40.6M13.8 43.5l7.7-2.9M13.8 22.5l7.7 18.1M13.8 22.5H32" />
                </g>
            </svg>
            <span class="shell-name">Dungeon Master · 平板</span>
        </div>
        @if (InWorkspace)
        {
            <nav class="tabs" aria-label="平板功能">
                <button class="@(_tab == TabBook ? "active" : "")" @onclick="() => SwitchTab(TabBook)">我的角色本</button>
                <button class="@(_tab == TabCards ? "active" : "")" @onclick="() => SwitchTab(TabCards)">全部线索卡</button>
                <button class="@(_tab == TabPublic ? "active" : "")" @onclick="() => SwitchTab(TabPublic)">公共对话</button>
                @if (State.Content.HandbookPageCount > 0)
                {
                    <button class="@(_tab == TabHandbook ? "active" : "")" @onclick="() => SwitchTab(TabHandbook)">组织者手册</button>
                }
            </nav>
        }
        <div class="shell-right">
            @if (HasRole)
            {
                <span class="shell-role stamp @(RoleName.Length <= 2 ? "vertical" : "")" aria-label="我的角色：@RoleName">@RoleName</span>
                <button class="tool" @onclick="Release">退出重选</button>
            }
        </div>
    </header>

    @if (State.StoryState == TabletStoryState.None)
    {
        <section class="wait">
            <div class="pulse" aria-hidden="true"></div>
            <h1>等待主持人选剧本</h1>
            <p class="lead">电脑一打开剧本，这里会自动变成选角色页，不用刷新。</p>
        </section>
    }
    else if (State.StoryState == TabletStoryState.Preparing)
    {
        <section class="wait">
            <div class="pulse" aria-hidden="true"></div>
            <h1>材料准备中</h1>
            <p class="lead">《@State.Content.StoryTitle》的卡片正在准备，几秒后自动开始。</p>
        </section>
    }
    else if (!HasRole)
    {
        <section class="join">
            <div class="join-intro">
                <h1>加入本局</h1>
                <p class="lead">
                    与电脑连接同一 Wi-Fi 后打开本页即可。选一个角色开始阅读；已被别人认领的角色不能再选。
                </p>

                <div class="address">
                    <label for="addr">本局地址</label>
                    <div class="address-row">
                        <input id="addr" readonly value="@Nav.BaseUri.TrimEnd('/')" />
                        <button @onclick="CopyAddress">复制</button>
                    </div>
                    <p class="hint">也可以扫描电脑上的二维码加入。</p>
                </div>
                @if (_copied)
                {
                    <p class="ok">地址已复制。</p>
                }
                @if (_copyFailed)
                {
                    <p class="warn">浏览器未允许自动复制，请选中上方网址后复制。</p>
                }
            </div>

            <div class="join-roles">
            <ul class="role-list">
                @foreach (var role in State.Roles)
                {
                    var taken = State.ClaimedRoles.Contains(role.RoleId, StringComparer.Ordinal);
                    <li>
                        <button disabled="@taken" @onclick="() => Claim(role.RoleId)">
                            <span class="role-name">@role.DisplayName</span>
                            <span class="role-sub">@(taken ? "已被认领" : "可认领")</span>
                        </button>
                    </li>
                }
            </ul>
            @if (_claimFailed)
            {
                <p class="warn">这个角色刚被别人认领了，请另选一个。</p>
            }
            </div>
        </section>
    }
    else
    {
        <div class="workspace">
            @if (_tab == TabBook)
            {
                <RoleReader @key="session.RoleId" Book="Book" RoleName="@RoleName" Settings="session.Settings"
                            Offset="session.ReadingOffset" OnProgress="ProgressCallback" />
            }
            else if (_tab == TabHandbook && Handbook is { } handbook)
            {
                @* 手册只读、不记进度：页码只留在这一页的内存里，刷新就回第 1 页。 *@
                <RoleReader @key="handbook" Book="handbook" RoleName="组织者手册" Settings="_handbookSettings"
                            SourceUrlPrefix="/tablet/handbook/source/" SourceOnly="true"
                            OnProgress="update => _handbookSettings = update.Settings" />
            }
            else if (_tab == "cards")
            {
                <section class="cards">
                    <div class="cards-side">
                    <h2>全部线索卡</h2>
                    <p class="lead">点哪张看哪张，只在这台设备上显示。暂停分发的组用纸质卡。</p>
                    <ul class="card-list">
                        @foreach (var card in State.Cards)
                        {
                            <li>
                                @if (card.IsAvailable)
                                {
                                    <button class="@(session.SelectedCardId == card.CardId ? "active" : "")"
                                            @onclick="() => Select(card.CardId)">
                                        <span class="card-name">@card.DisplayName</span>
                                        <span class="card-sub">@card.GroupName · @card.SourceOrder</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="unavailable" disabled>
                                        <span class="card-name">@card.DisplayName</span>
                                        <span class="card-sub">@card.GroupName · @card.SourceOrder ·
                                            @TabletNotReadyText.Describe(card.NotReadyReason)</span>
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                    </div>
                    <div class="cards-view">
                    @if (session.SelectedCardId is not null)
                    {
                        <figure class="shot">
                            <img src="/tablet/cards/@Uri.EscapeDataString(session.SelectedCardId)/front" alt="线索卡" @onclick="() => OpenCardAsync(session.SelectedCardId!)" />
                        </figure>
                    }
                    else
                    {
                        <p class="cards-empty">点左边的一张卡，卡面显示在这里。</p>
                    }
                    </div>
                </section>
            }
            else
            {
                <LiveBoard Ui="_ui" Lines="PublicFeed" FeedConnected="@(_publicSessionId.Length != 0)" FeedFailed="_feedFailed" />
            }
        </div>
    }

    <SpeechBar SessionKey="@_sessionKey" HasRole="@HasRole" HostBusy="@_hostBusy" HostSpeaking="@_hostSpeaking"
               ShowPanelToggle="@(_tab != TabPublic)" RecentLines="@RecentLines" />
</div>

@code {
    private const string TabBook = "book";
    private const string TabCards = "cards";
    private const string TabPublic = "public";
    private const string TabHandbook = "handbook";

    private string _tab = TabBook;
    private bool _claimFailed;
    private bool _copied;
    private bool _copyFailed;

    private TabletUiProjection? _ui;

    private string _sessionKey = string.Empty;
    private bool _hostBusy;
    private bool _hostSpeaking;

    /// <summary>剧本已就绪且本机已认领角色：这时顶栏里出现三个页签。</summary>
    private bool InWorkspace => State.StoryState is not (TabletStoryState.None or TabletStoryState.Preparing) && HasRole;

    /// <summary>换剧本时内容先于认领清空：以当前内容里还找得到这个角色为准，找不到就当没认领，不抛异常。</summary>
    private bool HasRole => State.Session(_sessionKey).RoleId is { } id
        && State.Roles.Any(r => r.RoleId == id)
        && State.Content.RoleBooks.ContainsKey(id);

    private RoleBookText Book => State.Content.RoleBooks[State.Session(_sessionKey).RoleId!];

    private ReadingSettings _handbookSettings = new();
    private RoleBookText? _handbook;

    // 阅读器按引用判断换没换书，所以页数不变时复用同一个对象，免得每次重绘都跳回第 1 页。
    private RoleBookText? Handbook
    {
        get
        {
            var count = State.Content.HandbookPageCount;
            if (count == 0) return null;
            if (_handbook?.SourcePageAssetIds.Count != count)
            {
                _handbook = new RoleBookText
                {
                    RoleId = string.Empty,
                    Chapters = [],
                    SourcePageAssetIds = [.. Enumerable.Range(1, count).Select(page => $"handbook-{page}")],
                };
                _handbookSettings = new();
            }
            return _handbook;
        }
    }

    private string RoleName => State.Roles.FirstOrDefault(r => r.RoleId == State.Session(_sessionKey).RoleId)?.DisplayName ?? string.Empty;

    /// <summary>公开对话：来自服务端给的公开消息来源，跟电脑那边说的是同一份。</summary>
    private List<(string Kind, string Text)> PublicFeed { get; } = [];

    /// <summary>对话面板只放最近 8 条公开消息。</summary>
    private IReadOnlyList<(string Kind, string Text)> RecentLines => PublicFeed.TakeLast(8).ToArray();
    private readonly CancellationTokenSource _feedCancellation = new();
    private Task? _feedPolling;
    private string _publicSessionId = string.Empty;
    private int _feedGeneration;
    private long _publicSequence;
    private bool _feedFailed;

    protected override async Task OnInitializedAsync()
    {
        // 渲染时已经发过 Cookie，这里直接复用同一个键。
        _sessionKey = TabletSessions.KeyFor(Http.HttpContext) ?? string.Empty;
        TabletSessions.Changed += OnAnySessionChanged;
        await LoadPublicFeedAsync();
        _feedPolling = PollPublicFeedAsync();
    }

    /// <summary>读公开消息。空的一段就说实话：还没有公开消息。</summary>
    private async Task LoadPublicFeedAsync(bool notify = false)
    {
        try
        {
            var generation = State.ContentGeneration;
            var snapshot = await Feed.ReadAsync(_publicSequence, _feedCancellation.Token);
            var reset = false;
            if (snapshot.SessionId != _publicSessionId || generation != _feedGeneration)
            {
                _publicSessionId = snapshot.SessionId;
                _feedGeneration = generation;
                _publicSequence = 0;
                PublicFeed.Clear();
                snapshot = await Feed.ReadAsync(0, _feedCancellation.Token);
                reset = true;
            }
            var fresh = snapshot.Messages.Where(m => m.Sequence > _publicSequence)
                .Select(m => (Kind: KindOf(m.Kind), Text: m.Text)).ToList();
            PublicFeed.AddRange(fresh);
            _publicSequence = snapshot.NextSequence;
            _feedFailed = false;

            if (notify && !reset)
            {
                var candidate = fresh.LastOrDefault(m => m.Kind is "host" or "event");
                if (candidate.Text is { } text)
                {
                    try { await Js.InvokeVoidAsync("tabletViewer.notify", text); }
                    catch (JSDisconnectedException) { }
                    catch (InvalidOperationException) { }
                }
            }
        }
        catch (OperationCanceledException) when (_feedCancellation.IsCancellationRequested) { }
        catch (Exception) { _feedFailed = true; }
        // 界面投影只取环节与按钮状态；公开消息已由上面的来源累积，这里不再用 Messages。
        try
        {
            _ui = await Ui.ReadAsync(_publicSequence, Speech.HostBusy, Speech.HostSpeaking, _feedCancellation.Token);
        }
        catch (OperationCanceledException) when (_feedCancellation.IsCancellationRequested) { }
        catch (Exception) { _ui = null; }
        // 输入条在所有页签都显示，每轮轮询都顺手刷新主持状态并重画。
        _hostBusy = Speech.HostBusy;
        _hostSpeaking = Speech.HostSpeaking;
        StateHasChanged();
    }

    private async Task PollPublicFeedAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(_feedCancellation.Token))
            {
                await InvokeAsync(() => LoadPublicFeedAsync(notify: true));
            }
        }
        catch (OperationCanceledException) when (_feedCancellation.IsCancellationRequested) { }
    }

    private static string KindOf(PublicMessageKind kind) => kind switch
    {
        PublicMessageKind.PlayerSpeech => "player",
        PublicMessageKind.HostReply => "host",
        _ => "event",
    };

    public async ValueTask DisposeAsync()
    {
        TabletSessions.Changed -= OnAnySessionChanged;
        _feedCancellation.Cancel();
        if (_feedPolling is not null) { await _feedPolling; }
        _feedCancellation.Dispose();
    }

    /// <summary>任何会话变化都重画：别的设备认领后，这里的「已被认领」要立刻更新。</summary>
    private void OnAnySessionChanged() => InvokeAsync(StateHasChanged);

    private void Claim(string roleId)
    {
        _claimFailed = !State.TryClaim(_sessionKey, roleId);
        TabletSessions.RaiseChanged();
    }

    private void Release()
    {
        State.Release(_sessionKey);
        _tab = TabBook;
        TabletSessions.RaiseChanged();
    }

    private void SwitchTab(string tab)
    {
        _tab = tab;
        TabletSessions.RaiseChanged();
    }

    private void Select(string cardId)
    {
        State.Session(_sessionKey).SelectedCardId = cardId;
        TabletSessions.RaiseChanged();
    }

    private Task OpenCardAsync(string cardId) => Js.InvokeVoidAsync("tabletViewer.open", new[] { $"/tablet/cards/{Uri.EscapeDataString(cardId)}/front" }, 0, true, null).AsTask();

    private void SaveProgress(ReadingProgressUpdate update)
    {
        var session = State.Session(_sessionKey);
        session.ReadingOffset = Math.Max(0, update.CharacterOffset);
        session.Settings = ReadingSettings.Clamp(update.Settings);
    }

    /// <summary>阅读器进度回调。Blazor 的 EventCallback 只接受同类型委托，用工厂构造。</summary>
    private EventCallback<ReadingProgressUpdate> ProgressCallback =>
        EventCallback.Factory.Create<ReadingProgressUpdate>(this, SaveProgress);

    private async Task CopyAddress()
    {
        _copied = await Js.InvokeAsync<bool>("tabletClipboard.copy", Nav.BaseUri.TrimEnd('/'));
        _copyFailed = !_copied;
    }
}
