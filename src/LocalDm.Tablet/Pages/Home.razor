@page "/"
@using LocalDm.Core.Tablet
@inject TabletSpikeState State
@inject IHttpContextAccessor Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IPublicFeedSource Feed
@implements IDisposable
@* 交互渲染模式必须显式声明：只注册 AddInteractiveServerComponents 不会让按钮生效。 *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@{
    // 没有会话 Cookie 时现场发一个：每台设备各拿各的键。
    var session = State.Session(_sessionKey);
}

<div class="shell">
    <header class="shell-bar">
        <div class="shell-title">
            <span class="mark" aria-hidden="true">局</span>
            <span>本局主持 · 平板</span>
        </div>
        <div class="shell-right">
            @if (session.RoleId is not null)
            {
                <span class="shell-role">@State.Roles.First(r => r.RoleId == session.RoleId).DisplayName</span>
                <button class="tool" @onclick="Release">退出重选</button>
            }
        </div>
    </header>

    @if (session.RoleId is null)
    {
        <section class="join">
            <h1>加入本局</h1>
            <p class="lead">
                与电脑连接同一 Wi-Fi 后打开本页即可。选一个角色开始阅读；已被别人认领的角色不能再选。
            </p>

            <div class="address">
                <label for="addr">本局地址</label>
                <div class="address-row">
                    <input id="addr" readonly value="@Nav.BaseUri.TrimEnd('/')" />
                    <button @onclick="CopyAddress">复制</button>
                </div>
                <p class="hint">也可以扫描电脑上的二维码加入。</p>
            </div>

            <ul class="role-list">
                @foreach (var role in State.Roles)
                {
                    var taken = State.ClaimedRoles.Contains(role.RoleId, StringComparer.Ordinal);
                    <li>
                        <button disabled="@taken" @onclick="() => Claim(role.RoleId)">
                            <span class="role-name">@role.DisplayName</span>
                            <span class="role-sub">@(taken ? "已被认领" : "可认领")</span>
                        </button>
                    </li>
                }
            </ul>
            @if (_claimFailed)
            {
                <p class="warn">这个角色刚被别人认领了，请另选一个。</p>
            }
            @if (_copied)
            {
                <p class="ok">地址已复制。</p>
            }
            @if (_copyFailed)
            {
                <p class="warn">浏览器未允许自动复制，请选中上方网址后复制。</p>
            }
        </section>
    }
    else
    {
        <div class="workspace">
            <nav class="tabs" aria-label="平板功能">
                <button class="@(_tab == TabBook ? "active" : "")" @onclick="() => SwitchTab(TabBook)">我的角色本</button>
                <button class="@(_tab == TabCards ? "active" : "")" @onclick="() => SwitchTab(TabCards)">全部线索卡</button>
                <button class="@(_tab == TabPublic ? "active" : "")" @onclick="() => SwitchTab(TabPublic)">公共对话</button>
            </nav>

            @if (_tab == TabBook)
            {
                <RoleReader @key="session.RoleId" Book="Book" RoleName="@RoleName" Settings="session.Settings"
                            Offset="session.ReadingOffset" OnProgress="ProgressCallback" />
            }
            else if (_tab == "cards")
            {
                <section class="cards">
                    <h2>全部线索卡</h2>
                    <p class="lead">点哪张看哪张，只在这台设备上显示。暂停分发的组用纸质卡。</p>
                    <ul class="card-list">
                        @foreach (var card in State.Cards)
                        {
                            <li>
                                @if (card.IsAvailable)
                                {
                                    <button class="@(session.SelectedCardId == card.CardId ? "active" : "")"
                                            @onclick="() => Select(card.CardId)">
                                        <span class="card-name">@card.DisplayName</span>
                                        <span class="card-sub">@card.GroupName · @card.SourceOrder</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="unavailable" disabled>
                                        <span class="card-name">@card.DisplayName</span>
                                        <span class="card-sub">@card.GroupName · @card.SourceOrder ·
                                            @TabletNotReadyText.Describe(card.NotReadyReason)</span>
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                    @if (session.SelectedCardId is not null)
                    {
                        <figure class="shot">
                            <img src="/tablet/cards/@Uri.EscapeDataString(session.SelectedCardId)/front" alt="线索卡" />
                        </figure>
                    }
                </section>
            }
            else
            {
                <section class="public">
                    <h2>公共对话</h2>
                    <p class="lead">只读。提问、推进、投票和揭秘都在电脑上完成。</p>
                    @if (PublicFeed.Count == 0)
                    {
                        <p class="lead">还没有公开消息：电脑那边还没把这一局的对话接过来。</p>
                    }
                    <ol class="feed">
                        @foreach (var line in PublicFeed)
                        {
                            <li class="@line.Kind">@line.Text</li>
                        }
                    </ol>
                </section>
            }
        </div>
    }
</div>

@code {
    private const string TabBook = "book";
    private const string TabCards = "cards";
    private const string TabPublic = "public";

    private string _tab = TabBook;
    private bool _claimFailed;
    private bool _copied;
    private bool _copyFailed;

    private string _sessionKey = string.Empty;

    private RoleBookText Book => State.Content.RoleBooks[State.Session(_sessionKey).RoleId!];

    private string RoleName => State.Roles.First(r => r.RoleId == State.Session(_sessionKey).RoleId).DisplayName;

    /// <summary>公开对话：来自服务端给的公开消息来源，跟电脑那边说的是同一份。</summary>
    private IReadOnlyList<(string Kind, string Text)> PublicFeed { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        // 渲染时已经发过 Cookie，这里直接复用同一个键。
        _sessionKey = TabletSessions.KeyFor(Http.HttpContext) ?? string.Empty;
        TabletSessions.Changed += OnAnySessionChanged;
        await LoadPublicFeedAsync();
    }

    /// <summary>读公开消息。空的一段就说实话：还没有公开消息。</summary>
    private async Task LoadPublicFeedAsync()
    {
        var snapshot = await Feed.ReadAsync(0, CancellationToken.None);
        PublicFeed = snapshot.Messages
            .Select(m => (Kind: KindOf(m.Kind), Text: m.Text))
            .ToArray();
        StateHasChanged();
    }

    private static string KindOf(PublicMessageKind kind) => kind switch
    {
        PublicMessageKind.PlayerSpeech => "player",
        PublicMessageKind.HostReply => "host",
        _ => "event",
    };

    void IDisposable.Dispose() => TabletSessions.Changed -= OnAnySessionChanged;

    /// <summary>任何会话变化都重画：别的设备认领后，这里的「已被认领」要立刻更新。</summary>
    private void OnAnySessionChanged() => InvokeAsync(StateHasChanged);

    private void Claim(string roleId)
    {
        _claimFailed = !State.TryClaim(_sessionKey, roleId);
        TabletSessions.RaiseChanged();
    }

    private void Release()
    {
        State.Release(_sessionKey);
        _tab = TabBook;
        TabletSessions.RaiseChanged();
    }

    private void SwitchTab(string tab)
    {
        _tab = tab;
        TabletSessions.RaiseChanged();
    }

    private void Select(string cardId)
    {
        State.Session(_sessionKey).SelectedCardId = cardId;
        TabletSessions.RaiseChanged();
    }

    private void SaveProgress(ReadingProgressUpdate update)
    {
        var session = State.Session(_sessionKey);
        session.ReadingOffset = Math.Max(0, update.CharacterOffset);
        session.Settings = ReadingSettings.Clamp(update.Settings);
    }

    /// <summary>阅读器进度回调。Blazor 的 EventCallback 只接受同类型委托，用工厂构造。</summary>
    private EventCallback<ReadingProgressUpdate> ProgressCallback =>
        EventCallback.Factory.Create<ReadingProgressUpdate>(this, SaveProgress);

    private async Task CopyAddress()
    {
        _copied = await Js.InvokeAsync<bool>("tabletClipboard.copy", Nav.BaseUri.TrimEnd('/'));
        _copyFailed = !_copied;
    }
}
