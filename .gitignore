# Private source material and runtime state
/stories/
.env
.env.*
!.env.example
*.key
*.pem
/.local/
/data/
/artifacts/
/TestResults/
**/bin/
**/obj/
**/node_modules/
**/.vs/
*.user
*.suo
*.db
*.db-shm
*.db-wal
# Machine-bound preview verification helper, not a product dependency
/docs/preview/verify-preview.mjs

# Local toolchain (Flutter SDK, Android SDK, JDK, Playwright browsers) — installed into the project, never committed
/.tools/

# .NET tooling state, packaging output and test artifacts
*.binlog
*.secure
*.msix
*.msixupload
*.AppxPackage/
/coverage*/
*.coverage
*.trx
/packaging/windows/Output/

# Runtime application data root (single SQLite file, DPAPI blobs, logs, prepared packages)
# Never inside the install directory; local dev copies stay untracked.
/.appdata/
/LocalDm/

# Playwright CLI 的本机运行产物（快照、控制台日志、截图副本）
/.playwright-cli/

# Synthetic fixture ground truth: kept locally for tests, never committed
/fixtures/synthetic/.private/

# Python caches from the helper scripts
__pycache__/
*.pyc

# 语音调试产物：本机试音生成的音频，不入库
/test_*.mp3
/test_*.wav
/scratch_*.mp3
/scratch_*.wav

# 界面测试早前写错目录留下的截图副本（正式产物在 /artifacts/ui/）
/tests/LocalDm.UiTests/artifacts/

# 本机运行数据（含剧本包全文）
/.appdata/
/.archify/
/.playwright-mcp/

# Overnight runner local config (contains machine-specific agent commands)
/tools/overnight/agents.json
/OVERNIGHT-QUESTION.md
.tmp/
